layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for item in site.pages %}
    {% if item.url and item.url != '/404.html' %}
      <url>
        <loc>{{ item.url | absolute_url }}</loc>
        <changefreq>monthly</changefreq>
      </url>
    {% endif %}
  {% endfor %}
</urlset>
